{
  "name": "dag-iot-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "corepack pnpm -r --parallel run dev",
    "dev:web": "corepack pnpm --filter @dag/web dev",
    "dev:server": "corepack pnpm --filter @dag/server dev",
    "build": "corepack pnpm -r run build",
    "test": "corepack pnpm -r run test",
    "test:unit": "corepack pnpm --filter @dag/server test && corepack pnpm --filter @dag/web test",
    "lint": "corepack pnpm -r run lint --if-present"
  }
}

{
  "name": "dag-iot-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @dag/web dev",
    "dev:server": "pnpm --filter @dag/server dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @dag/server test && pnpm --filter @dag/web test",
    "lint": "pnpm -r run lint --if-present"
  }
}
